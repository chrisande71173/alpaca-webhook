# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git - only commit .env.example

# Get these from Alpaca Dashboard > Paper Trading > API Keys
APCA_API_KEY_ID=your_alpaca_api_key_here
APCA_API_SECRET_KEY=your_alpaca_secret_key_here

# Use paper-api for testing, api.alpaca.markets for live
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Password for the /settings page (any username works). Leave unset to turn the page off.
ADMIN_PASSWORD=choose_a_long_password_here

# Where settings saved from the /settings page are stored. On Railway, mount a
# volume at /data and set this to /data/settings.json so they survive redeploys.
# SETTINGS_PATH=/data/settings.json

# Make up a random secret phrase - use the same one in your TradingView alert
WEBHOOK_SECRET=make_up_a_random_secret_phrase_here
